/** @var \Magento\Backend\Block\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
?>
<?php $settings = $block->getSettings() ?>
<?php if (isset($settings['identifier'])): ?>
    <div class="identifier-wrapper">
        <?= $escaper->escapeHtml(__('Identifier')) ?> :
        <span class="identifier"><?= $escaper->escapeHtml($settings['identifier']) ?></span>
        <input
            name="form_fields[<?= $escaper->escapeHtmlAttr($block->getFormFieldId()) ?>][identifier]"
            style="display:none" class="identifier-input" type="text"
            value="<?= $escaper->escapeHtmlAttr($settings['identifier']) ?>"
        />
    </div>
<?php endif ?>
